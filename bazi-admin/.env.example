# 数据库配置示例
# 复制此文件为 .env 并修改为实际配置

# PostgreSQL 数据库连接 URL
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bazi_db

# Redis 配置
# 格式: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# 服务器配置
HOST=127.0.0.1
PORT=9000

# 环境
ENVIRONMENT=development

# DeepSeek AI 配置
# 在 https://platform.deepseek.com 申请 API Key 后填入
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# JWT 认证配置
# 生产环境请务必修改为强随机字符串！可使用: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
# Access Token 过期时间（分钟），默认 10080 = 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 微信小程序配置（Phase 1 新增）
# 在微信公众平台 https://mp.weixin.qq.com 获取
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# 默认用户头像（东方美学风格，部署后替换为 CDN 地址）
DEFAULT_AVATAR_URL=https://your-cdn.com/avatars/default_zen.png

# 管理后台配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY_ADMIN=your-secret-key-for-admin-session-change-this-in-production
